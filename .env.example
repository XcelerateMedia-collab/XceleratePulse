# Turso Cloud Database Credentials (https://app.turso.tech/)
# (Required for Vercel production deployment)
TURSO_DATABASE_URL="libsql://your-database-slug.turso.io"
TURSO_AUTH_TOKEN="your-turso-auth-jwt-token"

# Google Sheets Webhook Secret Key
# Matches API_KEY in src/google-apps-script/Code.gs
SYNC_API_KEY="xcelerate-pulse-sync-secret"

# Google Apps Script Web App Deployment URL
GOOGLE_APPS_SCRIPT_WEBAPP_URL="https://script.google.com/macros/s/your-script-id/exec"
NEXT_PUBLIC_GOOGLE_APPS_SCRIPT_WEBAPP_URL="https://script.google.com/macros/s/your-script-id/exec"

# Application Base URL
NEXT_PUBLIC_APP_URL="https://xcelerate-pulse.vercel.app"
NEXT_PUBLIC_TUNNEL_URL="https://xcelerate-pulse.vercel.app"

# Optional Google Drive Folder for Proof Screenshot Uploads
GOOGLE_DRIVE_FOLDER_ID=""

# Master Google Spreadsheet ("Execution Pipeline") URL
NEXT_PUBLIC_MASTER_SPREADSHEET_URL="https://docs.google.com/spreadsheets/d/173oty1YHofleHqdOs0ItSGjlPfCIZi692GxaHbNJl6g/edit"
